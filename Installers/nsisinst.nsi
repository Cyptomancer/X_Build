; Script generated by the HM NIS Edit Script Wizard.

; Set the name of the installer and the output file
Outfile "Installer.exe"
Name "My Open Source App Installer"
Caption "My Open Source App Installation"

; Define default installation directory (System directory)
InstallDir "$SysDir"

; Request application privileges for UAC elevation
RequestExecutionLevel admin

; Pages
Page directory
Page instfiles

; Uninstaller
UninstallCaption "Uninstall My Open Source App"
UninstallIcon "$INSTDIR\main.exe"
UninstallExe "$INSTDIR\uninstall.exe"

Section "MainSection" SEC01

; Set output path for installation
SetOutPath $INSTDIR

; Copy main.exe to the installation directory
File "path\to\main.exe"

; Write the License and EULA
LicenseData "path\to\OpenSourceLicense.txt"
LicenseBkColor $COLOR_BLUE
LicenseTextColor $COLOR_WHITE
LicenseForceSelection

; Display the EULA
!insertmacro MUI_PAGE_LICENSE "path\to\GenericEULA.txt"

SectionEnd

Section "Uninstall"

; Remove installed files
Delete $INSTDIR\main.exe

; Remove uninstaller
Delete $INSTDIR\uninstall.exe

; Remove the installation directory (if empty)
RMDir $INSTDIR

SectionEnd